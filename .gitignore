# =============================================================================
# Secrets et variables d'environnement — NE JAMAIS commiter
# =============================================================================
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local
*.env

# Dépendances
node_modules/

# =============================================================================
# Clés de signature Android — NE JAMAIS commiter
# Un keystore poussé sur GitHub permet à quiconque de signer une mise à jour
# à notre place. Irrécupérable : la clé ne peut pas être changée après coup
# sur une fiche Play Store existante.
# =============================================================================
*.jks
*.keystore
key.properties
local.properties

# =============================================================================
# Projet Smokido — suivi dans son propre dépôt (tamarI-TM/smokido)
# Contient le keystore de release, à ne pas dupliquer ici.
# =============================================================================
livrables/SMOKIDO/

# =============================================================================
# Documents importés — commerciaux, fournisseurs, personnels
# Ce dépôt est PUBLIC : factures, devis, rapports de tests fournisseur,
# plans marketing et médias bruts ne doivent jamais y être publiés.
# =============================================================================
context/import/

# Filet de sécurité : mêmes types de documents ailleurs dans context/
context/**/*.pdf
context/**/*.mp4
context/**/*.mov
context/**/*.xlsx
context/**/*.docx
context/**/*.pptx
context/**/Proforma*
context/**/*Invoice*
context/**/*facture*
